<div class="overlay" @onclick="HandleOnClickOutsideModal">
</div>
<div role="dialog" class="left-panel overflow-y" style="@(PanelStyle)">
    @ChildContent
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Gap { get; set; }

    [Parameter]
    public EventCallback OnClickOutsideModel { get; set; }

    private string? PanelStyle => Gap != null ? $"top: {Gap}; left: {Gap}; bottom: {Gap};" : null;

    async Task HandleOnClickOutsideModal()
    {
        await OnClickOutsideModel.InvokeAsync();
    }
}
