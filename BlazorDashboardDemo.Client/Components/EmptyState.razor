<div class="empty-state-container @CssClass">
    @if (!string.IsNullOrEmpty(Icon))
    {
        <i class="@Icon empty-state-icon"></i>
    }
    @if (!string.IsNullOrEmpty(Title))
    {
        <h3 class="empty-state-title">@Title</h3>
    }
    @if (!string.IsNullOrEmpty(Message))
    {
        <p class="empty-state-message">@Message</p>
    }
    @if (ShowAction)
    {
        <div class="empty-state-action">
            <Button Intent="Button.ButtonIntent.Primary"
                    Text="@ActionText"
                    OnClick="OnActionClick" />
        </div>
    }
    @ChildContent
</div>

@code {
    [Parameter]
    public string? Icon { get; set; } = "fa-solid fa-inbox";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Message { get; set; }

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public bool ShowAction { get; set; }

    [Parameter]
    public string ActionText { get; set; } = "Take Action";

    [Parameter]
    public EventCallback OnActionClick { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}