<div class="@(RequireBackground ? "timestamp-bg center-flex" : "")">

     @if (DisplayAsDate)
    {
       <span class="timestamp-text">@(Date.ToString("dd MMM yyyy"))</span>
    }
    else
    {
      <span class="timestamp-text"> @FormattedDate</span>
    }

</div>

@code {
    [Parameter, EditorRequired] public DateTime Date { get; set; }
    [Parameter] public bool RequireBackground { get; set; }
    [Parameter] public bool DisplayAsDate { get; set; }

    private string FormattedDate => Date.ToShortDateString();
}