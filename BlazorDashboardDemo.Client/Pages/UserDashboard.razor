@page "/userdashboard"
@using BlazorDashboardDemo.Shared.Models
@using BlazorDashboardDemo.Shared.Services
@inject IUserDashboardService DashboardService


<TopBottomLayout Mode="TopBottomLayout.LayoutMode.ExpandBottom">
    <Top>
        <div class="dashboard-header">
            <h1>Dashboard</h1>
        </div>
    </Top>
    <Bottom>
        @if (isLoading)
        {
            <div class="loading-indicator">Loading...</div>
        }
        else if (viewModel is not null)
        {
            <LeftRightLayout LeftWidth="1fr" RightWidth="375px" Gap="25px">
                <Left>
                    <TopBottomLayout Gap="18px" Mode="TopBottomLayout.LayoutMode.StackFillingContainer" CssClass="h-100">
                        <Top>
                            <div class="dashboard-card">
                                <div class="dashboard-card-header">
                                    <h2>Pinned Tasks (@viewModel.PinnedTasks.Count())</h2>
                                </div>
                                <div class="dashboard-card-body ">
                                    @if (!viewModel.PinnedTasks.Any())
                                    {
                                        <div class="empty-state">
                                            <p>Pin a task to make it appear here</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="task-grid">
                                            @foreach (var task in viewModel.PinnedTasks)
                                            {
                                                <TaskCard Task="task" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </Top>
                        <Bottom>
                            <div class="dashboard-card">
                                <div class="dashboard-card-header">
                                    <h2>What's Next?</h2>
                                </div>
                                <div class="dashboard-card-body">
                                    @if (!viewModel.WhatsNextTasks.Any())
                                    {
                                        <div class="empty-state">
                                            <p>No tasks available</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="task-grid">
                                            @foreach (var task in viewModel.WhatsNextTasks)
                                            {
                                                <TaskCard Task="task" />
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        </Bottom>
                    </TopBottomLayout>
                </Left>
                <Right>
                    <div class="dashboard-card">
                        <div class="dashboard-card-header">
                            <h2>Updates</h2>
                        </div>
                        <div class="dashboard-card-body">
                            @if (!viewModel.WhatsNextTasks.Any())
                            {
                                <div class="empty-state">
                                    <p>No updates available</p>
                                </div>
                            }
                            else
                            {
                                <div class="task-grid">
                                    @foreach (var task in viewModel.WhatsNextTasks)
                                    {
                                        <TaskCard Task="task" />
                                    }
                                </div>
                            }
                        </div>

                    </div>
                </Right>
            </LeftRightLayout>
        }


    </Bottom>
</TopBottomLayout>




@code {
    private UserDashboardViewModel? viewModel;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            viewModel = await DashboardService.GetDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task ViewTask(TaskModel task)
    {
        // Implement view task logic
    }

    private async Task PinTask(TaskModel task)
    {
        task.IsPinned = true;
        await DashboardService.UpdateTaskAsync(task);
        StateHasChanged();
    }

    private async Task UnpinTask(TaskModel task)
    {
        task.IsPinned = false;
        await DashboardService.UpdateTaskAsync(task);
        StateHasChanged();
    }

    private async Task ClaimTask(TaskModel task)
    {
        task.AssignedUserId = viewModel?.CurrentUserId;
        await DashboardService.UpdateTaskAsync(task);
        StateHasChanged();
    }
}