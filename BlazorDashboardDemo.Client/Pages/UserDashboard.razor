@page "/userdashboard"
@using BlazorDashboardDemo.Shared.Models
@using BlazorDashboardDemo.Shared.Services
@inject IUserDashboardService DashboardService
@inject IJSRuntime JSRuntime


<TopBottomLayout Mode="TopBottomLayout.LayoutMode.ScrollBottom">
    <Top>
        <div class="dashboard-header">
            <h1>Dashboard</h1>
        </div>
    </Top>
    <Bottom>
        @if (isLoading)
        {
            <div class="loading-indicator">Loading...</div>
        }
        else if (viewModel is not null)
        {
            <LeftRightLayout LeftWidth="1fr" RightWidth="375px" Gap="25px">
                <Left>
                    <StackLayout Gap="18px" CssClass="h-100">

                        <div class="dashboard-card">
                            <div class="dashboard-card-header">
                                <h2>Pinned Tasks (@viewModel.PinnedTasks.Count())</h2>
                                <div class="row column-gap-5px dashboard-card-navigation">
                                    <span class="fa-solid fa-sm fa-chevron-left chevron-button" disabled="@isPreviousDisabled" @onclick="ShowPreviousCards" />
                                    <span class="fa-solid fa-sm fa-chevron-right chevron-button" disabled="@isNextDisabled" @onclick="ShowNextCards" />
                                </div>
                            </div>
                            <div class="dashboard-card-body ">
                                @if (!viewModel.PinnedTasks.Any())
                                {
                                    <EmptyState Title="No Tasks Available"
                                                Message="Pin a task to make it appear here" />
                                }
                                else
                                {
                                    <div class="dashboard-card-items row column-gap-25px">
                                        @foreach (var task in viewModel.PinnedTasks)
                                        {
                                            <TaskCard Task="task" OnViewTaskClicked="() => OpenTaskDialog(task)" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="dashboard-card">
                            <div class="dashboard-card-header">
                                <h2>What's Next?</h2>
                                <div class="row column-gap-5px">
                                    <span class="fa-solid fa-sm fa-chevron-left chevron-button" disabled="@isPreviousDisabled" @onclick="ShowPreviousCards" />
                                    <span class="fa-solid fa-sm fa-chevron-right chevron-button" disabled="@isNextDisabled" @onclick="ShowNextCards" />
                                </div>
                            </div>
                            <div class="dashboard-card-body">
                                @if (!viewModel.WhatsNextTasks.Any())
                                {
                                    <EmptyState Title="No Tasks Available" />
                                }
                                else
                                {
                                    <div class="dashboard-card-items row column-gap-25px">
                                        @foreach (var task in viewModel.WhatsNextTasks)
                                        {
                                            <TaskCard Task="task" OnViewTaskClicked="() => OpenTaskDialog(task)" />
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </StackLayout>
                </Left>
                <Right>
                    <div class="column UpdateDashboard-card">
                        <div class="row align-middle gap-20px">
                            <h2>Updates</h2>
                        </div>
                        <div class="column">
                            @if (!viewModel.WhatsNextTasks.Any())
                            {

                                <EmptyState Title="No updates Available"
                                            Message="There are no updates to display at this time." />
                            }
                            else
                            {
                                @foreach (var task in viewModel.WhatsNextTasks)
                                {
                                    var description = $"The task for {task.ProjectName} has been successfully completed, though it came with a few challenges along the way.";

                                    <TaskUpdateCard UpdateType="Step Reactivation"
                                                    Title="@task.Name"
                                                    Description="@description"
                                                    UserName="John Smith"
                                                    Date="@task.CreatedDate" />
                                }
                            }
                        </div>

                    </div>
                </Right>
            </LeftRightLayout>
        }
    </Bottom>
</TopBottomLayout>


@if (isTaskDialogVisible && selectedTask is not null)
{
    <ModalPanelRight OnClickOutsideModel="CloseTaskDialog">
        <TaskSummaryDialog TaskModel="selectedTask"
                           OnPinTaskClicked="() => PinTask(selectedTask)"
                           OnUnPinTaskClicked="() => UnpinTask(selectedTask)" />
    </ModalPanelRight>
}

@code {
    private UserDashboardViewModel? viewModel;
    private bool isLoading = true;

    // State for TaskSummaryDialog
    private TaskModel? selectedTask;
    private bool isTaskDialogVisible = false;

    private List<TaskModel> visibleTasks = new();
    private int currentStartIndex = 0;
    private int cardsPerPage = 5; // Default value, will be calculated dynamically
    private bool isPreviousDisabled => currentStartIndex == 0;
    private bool isNextDisabled => currentStartIndex + cardsPerPage >= viewModel?.WhatsNextTasks.Count();
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            cardsPerPage = await CalculateCardsPerPageAsync();
            UpdateVisibleTasks();
        }
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            isLoading = true;
            viewModel = await DashboardService.GetDashboardDataAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
    private void OpenTaskDialog(TaskModel task)
    {
        selectedTask = task;
        isTaskDialogVisible = true;
    }

    private void CloseTaskDialog()
    {
        selectedTask = null;
        isTaskDialogVisible = false;
    }

    private async Task PinTask(TaskModel task)
    {
        task.IsPinned = true;
        await DashboardService.UpdateTaskAsync(task);
        StateHasChanged();
    }

    private async Task UnpinTask(TaskModel task)
    {
        task.IsPinned = false;
        await DashboardService.UpdateTaskAsync(task);
        StateHasChanged();
    }

    private async Task ClaimTask(TaskModel task)
    {
        task.AssignedUserId = viewModel?.CurrentUserId;
        await DashboardService.UpdateTaskAsync(task);
        StateHasChanged();
    }
    private async Task<int> CalculateCardsPerPageAsync()
    {
        // Use the injected JSRuntime instance to call JavaScript interop
        var containerWidth = await JSRuntime.InvokeAsync<int>("getContainerWidth", ".dashboard-card-items");
        const int cardWidth = 400; // Fixed card width
        const int columnGap = 25; // Fixed column gap

        // Calculate the total width required for each card (card width + column gap)
        int totalCardWidth = cardWidth + columnGap;

        // Calculate how many cards can fit within the container width
        return Math.Max(containerWidth / totalCardWidth, 1); // Ensure at least one card is displayed
    }

    private void UpdateVisibleTasks()
    {
        Console.WriteLine($"Updating visible tasks: StartIndex={currentStartIndex}, CardsPerPage={cardsPerPage}");
        visibleTasks = viewModel?.WhatsNextTasks.Skip(currentStartIndex).Take(cardsPerPage).ToList() ?? new List<TaskModel>();
        Console.WriteLine($"Visible tasks count: {visibleTasks.Count}");
    }

    private void ShowPreviousCards()
    {
        if (currentStartIndex > 0)
        {
            currentStartIndex -= cardsPerPage;
            UpdateVisibleTasks();
        }
    }

    private void ShowNextCards()
    {
        if (currentStartIndex + cardsPerPage < viewModel?.WhatsNextTasks.Count())
        {
            currentStartIndex += cardsPerPage;
            UpdateVisibleTasks();
        }
    }
}